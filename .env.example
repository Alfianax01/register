# Server & Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
APP_URL=https://your-domain.vercel.app
NODE_ENV=production

# -----------------------------------------------------------------------------
# DATABASE MYSQL (Vercel Serverless / PlanetScale / Railway / TiDB / Aiven)
